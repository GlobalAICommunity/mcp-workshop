# Copy this file to `.env` and edit it. `.env` is gitignored — never commit real keys.
#
# See docs/models.md for how to get credentials and which model names to use.

# Which model provider to use: ollama | google | grok | foundry
MCP_WORKSHOP_PROVIDER=ollama

# Optional: override the default model for the selected provider.
# Defaults: ollama=qwen3:4b, google=gemini-flash-latest, grok=grok-4-fast, foundry=gpt-4o-mini
# MCP_WORKSHOP_MODEL=qwen3:8b


# --- ollama (local, no key, works offline) --------------------------------
# Install from https://ollama.com, then: ollama pull qwen3:4b
# OLLAMA_BASE_URL=http://localhost:11434/v1


# --- google (Gemini) ------------------------------------------------------
# Free key from https://aistudio.google.com/api-keys
# GOOGLE_API_KEY=


# --- grok (xAI) -----------------------------------------------------------
# Key from https://console.x.ai
# XAI_API_KEY=


# --- foundry (Microsoft / Azure AI Foundry) -------------------------------
# Create a deployment at https://ai.azure.com, then copy its endpoint and key.
# The endpoint should end in /openai/v1/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1/
# AZURE_OPENAI_API_VERSION=2024-10-21
